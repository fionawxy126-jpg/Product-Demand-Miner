{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/usr/local/lib/node_modules/@varveai/adit-cli/node_modules/@varveai/adit-hooks/dist/index.js\" --platform codex session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/usr/local/lib/node_modules/@varveai/adit-cli/node_modules/@varveai/adit-hooks/dist/index.js\" --platform codex prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/usr/local/lib/node_modules/@varveai/adit-cli/node_modules/@varveai/adit-hooks/dist/index.js\" --platform codex stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/usr/local/lib/node_modules/@varveai/adit-cli/node_modules/@varveai/adit-hooks/dist/index.js\" --platform codex notification",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
